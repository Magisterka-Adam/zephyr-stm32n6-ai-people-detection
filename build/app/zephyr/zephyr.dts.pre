   compatible = "st,stm32g0-exti", "st,stm32-exti";
   interrupt-controller;
   #interrupt-cells = <1>;
   #address-cells = <1>;
   reg = <0x56025000 0x400>;
   clocks = <&rcc (0x278) (1 << 0)>;
   num-lines = <96>;
   interrupts = <20 0>, <21 0>, <22 0>, <23 0>,

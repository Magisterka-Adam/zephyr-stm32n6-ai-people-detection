/ {
 arduino_header: connector {
  compatible = "arduino-header-r3";
  #gpio-cells = <2>;
  gpio-map-mask = <0xffffffff 0xffffffc0>;
  gpio-map-pass-thru = <0 0x3f>;
  gpio-map = <0 0 &gpioa 5 0>,
      <1 0 &gpioa 9 0>,
      <2 0 &gpioa 10 0>,
      <3 0 &gpioa 12 0>,
      <4 0 &gpiof 3 0>,
      <5 0 &gpiob 10 0>,
      <6 0 &gpiof 6 0>,
      <7 0 &gpiod 5 0>,
      <8 0 &gpiod 0 0>,
      <9 0 &gpioe 9 0>,
      <10 0 &gpioh 5 0>,
      <11 0 &gpioe 10 0>,
      <12 0 &gpioe 13 0>,
      <13 0 &gpiod 6 0>,
      <14 0 &gpioe 7 0>,
      <15 0 &gpioe 14 0>,
      <16 0 &gpioa 3 0>,
      <17 0 &gpiog 2 0>,
      <18 0 &gpioh 8 0>,
      <19 0 &gpioe 15 0>,
      <20 0 &gpioc 1 0>,
      <21 0 &gpioh 9 0>;
 };
};

arduino_serial: &usart2 {};

arduino_i2c: &i2c1 {};

arduino_spi: &spi5 {};

arduino_i3c: &i3c1 {};
